# Copy to .env and fill in. Without any of this, it runs in mock mode.
PROVIDER=mock
# PROVIDER=apifootball          # API-Football Pro — live xG + red cards
# APIFOOTBALL_KEY=your_key_here
# PROVIDER=sportmonks            # Sportmonks All-In — also has native xG
# SPORTMONKS_KEY=your_key_here
POLL_SECONDS=20
